# Copy to .env.deploy and fill in (never commit .env.deploy)
# Hostinger: hPanel → Websites → Manage → FTP Accounts

FTP_HOST=ftp.cinematicviewing.com
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_PORT=21
# Usually public_html — or domains/cinematicviewing.com/public_html
FTP_REMOTE_DIR=/public_html
